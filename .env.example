# xNFTs environment.
#
# ONLY four variables live here now. Everything else — the mint address, the
# project wallet, the treasury, the market links, the support handle — moved into
# the `protocol_config` table in Supabase, so it can be changed live without a
# redeploy. See supabase/migrations/20260806120000_protocol_config.sql.
#
# Why these four stayed: they are what a browser needs in order to REACH that
# table. Config that told you where to find itself would be circular.
#
# Vite substitutes VITE_ variables at BUILD time. Changing one requires a
# rebuild and redeploy — restarting is not enough. That property is exactly why
# the addresses were moved out.

# ---------------------------------------------------------------------------
# Supabase — Project Settings -> API
# ---------------------------------------------------------------------------

# Project URL, e.g. https://abcdefgh.supabase.co
VITE_SUPABASE_URL=

# The "anon / public" key. NEVER the service_role key — that one bypasses RLS
# entirely, and anything in a VITE_ variable is compiled into a file every
# visitor downloads.
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Solana
# ---------------------------------------------------------------------------

# Your own RPC (Helius, Triton, QuickNode). Empty falls back to the public
# mainnet-beta endpoint, which is rate-limited hard enough to drop requests
# under any real traffic.
VITE_SOLANA_RPC_URL=

# ---------------------------------------------------------------------------
# Admin desk
# ---------------------------------------------------------------------------

# SHA-256 of the /admin passcode. Generate with:
#   node -e "console.log(require('crypto').createHash('sha256').update('YOUR-PASSCODE').digest('hex'))"
#
# A digest, not the passcode, so the plaintext is not in the bundle. Be clear
# about what this buys: it hides the desk from casual visitors and nothing more.
# The control that actually holds is the project wallet's signature — no payout
# can be sent without it.
VITE_ADMIN_PASSCODE_SHA256=
